---
import type { Project } from '../lib/model';
import { guideFor } from '../data/guides';
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const guide = guideFor(p.id);
const base = import.meta.env.BASE_URL;
---

<article class="project-entry">
  <h3>
    <a href={`${base}projeler/${p.id}/`}>{p.name}</a>
  </h3>
  <p>{guide.summary}</p>
  <dl class="project-facts">
    <dt>Kim ödeyebilir?</dt>
    <dd>{guide.buyer}</dd>
    <dt>İlk teklif</dt>
    <dd>{guide.firstOffer}</dd>
  </dl>
  <p>
    <strong>İlk adım:</strong> {guide.nextStep}
  </p>
  <a href={`${base}projeler/${p.id}/#ilk-adimlar`}>
    {p.name} adım listesini aç
  </a>
</article>
