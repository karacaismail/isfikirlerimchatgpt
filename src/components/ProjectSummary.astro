---
import type { Candidate } from '../lib/strategy';
import { commercialLabels, positionLabels } from '../lib/product-value';
interface Props {
  candidate: Candidate;
}
const { candidate: c } = Astro.props;
const base = import.meta.env.BASE_URL;
const value = c.commercial;
---

<article class="project-entry">
  <p class="eyebrow">
    {value ? positionLabels[value.position] : 'İş fikri henüz netleşmedi'}
  </p>
  <h3>
    <a href={`${base}projeler/${c.id}/`}>{c.name}</a>
  </h3>
  <p>
    <strong>{value ? commercialLabels[value.action] : 'Belirlenemedi.'}</strong>
  </p>
  <p>{value?.reason || c.definition}</p>
  <dl class="project-facts">
    <dt>İlk alıcı hipotezi</dt>
    <dd>{value?.buyer || 'Belirlenemedi.'}</dd>
    <dt>Ayrıca neden ödesin?</dt>
    <dd>{value?.value || 'Gösterilemedi.'}</dd>
  </dl>
  <p>
    <strong>En güçlü itiraz:</strong> {value?.objection || 'Belirlenemedi.'}
  </p>
  <a href={`${base}projeler/${c.id}/#deger`}>
    Alıcı, alternatif ve adım listesini aç
  </a>
</article>
