---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog';
import { portfolio } from '../lib/data';
---

<Layout title="Proje kataloğu">
  <p class="eyebrow">Altı kişisel proje · {portfolio.date}</p>
  <h1>Projeler</h1>
  <p class="lede">
    Müşteri ve gelir hedefine göre filtrele. İlk teklifi ve yapılacakları gör.
  </p>
  <Catalog
    projects={portfolio.projects}
    base={import.meta.env.BASE_URL}
    mode="catalog"
    client:load
  />
</Layout>
