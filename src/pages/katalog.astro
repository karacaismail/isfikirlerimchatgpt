---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog';
import { toCatalogCandidates } from '../lib/catalog';
import { development } from '../data/development';
---

<Layout title="Proje kataloğu">
  <p class="eyebrow">
    {development.candidates.length} aday kayıt · Strateji {development.version}
  </p>
  <h1>Projeler</h1>
  <p class="lede">
    Kime, hangi sorun için, hazır alternatiften neden farklı bir ürün
    satılabilir? İlk görünümde yalnız dar satın alma hipotezleri var. Altyapı ve
    netleşmemiş fikirler için “Tüm çalışmalar”ı aç.
  </p>
  <Catalog
    candidates={toCatalogCandidates(development.candidates)}
    base={import.meta.env.BASE_URL}
    mode="catalog"
    client:load
  />
</Layout>
