---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog';
import { portfolio } from '../lib/data';
---

<Layout title="Proje kataloğu">
  <p class="eyebrow">Kanıta dayalı portföy · {portfolio.date}</p>
  <h1>Fikri değil, karşılığını incele.</h1>
  <p class="lede">
    Kimin hangi işini iyileştiriyor, kim ödeme yapabilir, bugün hangi parçası
    gerçekten var?
  </p>
  <p class="notice">
    Bu yayında yalnız kişisel projelerin arındırılmış özetleri yer alır.
    İnceleme tamamlanmadı; tüm değerlendirmeler kaynak kapsamıyla sınırlıdır.
  </p>
  <Catalog
    projects={portfolio.projects}
    base={import.meta.env.BASE_URL}
    mode="catalog"
    client:load
  />
</Layout>
