---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog';
import { development } from '../data/development';
---

<Layout title="Proje kataloğu">
  <p class="eyebrow">
    {development.candidates.length} aday kayıt · Strateji {development.version}
  </p>
  <h1>Projeler</h1>
  <p class="lede">
    Geliştirilecek yazılım dilimini, altyapı katkısını, reklamsız satış
    potansiyelini ve ECA önerisini karşılaştır. Ürün, çatı, araştırma ve
    platform kayıtları ayrı belirtilir.
  </p>
  <Catalog
    candidates={development.candidates}
    base={import.meta.env.BASE_URL}
    mode="catalog"
    client:load
  />
</Layout>
