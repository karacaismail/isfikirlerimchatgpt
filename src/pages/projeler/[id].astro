---
import Layout from '../../layouts/Layout.astro';
import TableScroll from '../../components/TableScroll.astro';
import { portfolio } from '../../lib/data';
import { criteria, groupIds, groupNames, scoreLabel } from '../../lib/model';
export function getStaticPaths() {
  return portfolio.projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL;
const sections = [
  ['Kullanıcı', p.user],
  ['Müşteri', p.customer],
  ['Ödeme yapan', p.payer],
  ['Sorun', p.problem],
  ['Değer hipotezi', p.value],
  ['Başlangıçta hedeflenen fikir', p.originalVision],
  ['Bugün kaynaklarda görülen', p.observed],
  ['Önerilen ticari yön', p.proposedDirection],
];
---

<Layout title={p.name} description={p.definition}>
  <p>
    <a href={`${base}katalog/`}>Kataloğa dön</a>
  </p>
  <p class="eyebrow">
    {p.kind} · {p.maturity.product} · Geçici değerlendirme
  </p>
  <h1>{p.name}</h1>
  <p class="lede">{p.definition}</p>
  <p class="meta">
    Diğer adlar: {p.aliases.join(', ') || 'Belirlenemedi'} · Son inceleme:{' '}
    {p.reviewDate}
  </p>
  <section class="notice">
    <h2>Karar: {p.decision}</h2>
    <p>{p.decisionRationale}</p>
    <p>
      <strong>Kararı değiştirecek kanıt:</strong> {p.changeEvidence}
    </p>
    <p>
      <strong>Çalıştırma:</strong> {p.confidence.runtime}
    </p>
  </section>
  <section class="reading">
    <h2>İşi hızlıca anla</h2>
    <dl>
      {sections.map(([label, text]) => (
        <>
          <dt>{label}</dt>
          <dd>{text}</dd>
        </>
      ))}
    </dl>
    <h3>En önemli engeller</h3>
    <ul>
      {p.blockers.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
  </section>
  <section>
    <h2>Dört ayrı karar ekseni</h2>
    <p class="reading">
      Puanlar analistin karar modelidir. Eksik ağırlıklar tek bir kesin toplamla
      kapatılmaz; görülen aralık istatistiksel güven aralığı değildir.
    </p>
    <div class="metrics">
      {groupIds.map((g) => (
        <div>
          <h3>{groupNames[g]}</h3>
          <p>
            <strong>{scoreLabel(g, p.scores[g])}</strong>
          </p>
          <p>
            {p.scores[g].find((c) => c.score !== null)?.rationale ||
              'Bu eksende puan verecek yeterli kanıt belirlenemedi.'}
          </p>
        </div>
      ))}
    </div>
  </section>
  <section class="reading">
    <h2>Gerçek kullanım yolu</h2>
    <p>
      Bu akış kaynak vizyonu ve önerilen ilk kapsamı anlatır; yerelde
      doğrulanmış uçtan uca davranış değildir.
    </p>
    <ol>
      {p.workflow.map((x) => (
        <li>{x}</li>
      ))}
    </ol>
    <h3>İlk satılabilir kapsam</h3>
    <ul>
      {p.mmp.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <h3>İlk satıştan önce gerekmeyenler</h3>
    <ul>
      {p.notNeeded.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <h3>Gelir modeli ve ticari seçenekler</h3>
    <ul>
      {p.monetization.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <ul>
      {p.commercialOptions.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <h3>Reklamsız ilk müşterilere erişim</h3>
    <p>{p.distribution}</p>
    <h3>Ürün içi yayılma döngüsü</h3>
    <p>{p.viralLoop}</p>
  </section>
  <section>
    <h2>Alternatifler ve değiştirme gerekçesi</h2>
    <ul>
      {p.alternatives.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <div class="project-grid">
      {p.competitors.map((c) => (
        <article class="project-entry">
          <h3>
            <a href={c.url} rel="noreferrer">
              {c.name}
            </a>
          </h3>
          <p>
            <strong>Müşteri:</strong> {c.customer}
          </p>
          <p>{c.solution}</p>
          <p>
            <strong>Fiyat ve birim:</strong> {c.price}
          </p>
          <p>
            <strong>Ücretsiz kullanım:</strong> {c.free}
          </p>
          <p>
            <strong>Güçlü taraf:</strong> {c.strength}
          </p>
          <p>
            <strong>Açık ihtiyaç hipotezi:</strong> {c.gap}
          </p>
          <p>
            <strong>Geçiş gerekçesi:</strong> {c.switching}
          </p>
          <p class="meta">
            Erişim: {c.accessed} · {c.limitation}
          </p>
        </article>
      ))}
    </div>
  </section>
  <section class="reading">
    <h2>Gelir senaryosu</h2>
    <p>{p.finance.status}</p>
    <ul>
      {p.finance.assumptions.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <p>
      <strong>1., 3. ve 6. ay — düşük, temel ve yüksek:</strong> Gerekçeli
      müşteri, dönüşüm ve maliyet girdileri belirlenemediği için hesaplanamadı.
      Eksik değerler sıfır değildir.
    </p>
    <p>{p.finance.conditions}</p>
    <p>
      Abonelik = aktif ödeme yapan müşteri × gerçekleşen dönem ücreti. Kurulum
      ve tek seferlik satış ayrı gelirlerdir. Faaliyet sonucu vergi ve tüm
      giderler tamamlanmadan net kâr diye adlandırılmaz.
    </p>
  </section>
  <section>
    <h2>İlk üç doğrulama deneyi</h2>
    <p>Eşikler ve emek aralıkları öneridir; bu deneyler yapılmadı.</p>
    <div class="project-grid">
      {p.experiments.map((e, i) => (
        <article class="project-entry">
          <h3>
            {i + 1}. {e.hypothesis}
          </h3>
          <dl>
            <dt>En küçük işlem</dt>
            <dd>{e.action}</dd>
            <dt>Ölçüm ve önerilen eşik</dt>
            <dd>
              {e.metric} — {e.threshold}
            </dd>
            <dt>Başarısızlık halinde</dt>
            <dd>{e.failure}</dd>
            <dt>Emek ve kaynak</dt>
            <dd>{e.effort}</dd>
          </dl>
        </article>
      ))}
    </div>
  </section>
  <section class="reading">
    <h2>Riskler</h2>
    <ul>
      {p.risks.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
  </section>
  <details>
    <summary>Derin inceleme: özellikler ve olgunluk</summary>
    <TableScroll label="Özellik durumu tablosu, yatay kaydırılabilir">
      <table>
        <thead>
          <tr>
            <th>Özellik</th>
            <th>Durum</th>
            <th>Kanıt</th>
          </tr>
        </thead>
        <tbody>
          {p.features.map((f) => (
            <tr>
              <th scope="row">{f.name}</th>
              <td>{f.status}</td>
              <td>{f.evidence.join(', ') || 'Belirlenemedi'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
    <dl>
      <dt>Ürün geliştirme</dt>
      <dd>{p.maturity.product}</dd>
      <dt>Ticari doğrulama</dt>
      <dd>{p.maturity.commercial}</dd>
      <dt>Kurumsal hazırlık</dt>
      <dd>{p.maturity.enterprise}</dd>
      <dt>Büyümeye hazırlık</dt>
      <dd>{p.maturity.scale}</dd>
    </dl>
    <h3>Platform eksenleri</h3>
    <dl>
      <dt>Mevcut</dt>
      <dd>{p.platforms.current.join(' · ')}</dd>
      <dt>Kaynakların hedefi</dt>
      <dd>{p.platforms.target.join(' · ')}</dd>
      <dt>Önerilen ilk sürüm</dt>
      <dd>{p.platforms.proposed.join(' · ')}</dd>
      <dt>Ertelenen</dt>
      <dd>{p.platforms.deferred.join(' · ')}</dd>
      <dt>İşletim</dt>
      <dd>{p.platforms.operation}</dd>
      <dt>Müşteri ilişkisi</dt>
      <dd>{p.platforms.relationship}</dd>
      <dt>Ticari yapı</dt>
      <dd>{p.platforms.structure}</dd>
    </dl>
  </details>
  <details>
    <summary>Ölçüt puanları ve gerekçeleri</summary>
    {groupIds.map((g) => (
      <section>
        <h3>{groupNames[g]}</h3>
        {p.scores[g].map((c) => (
          <article class="project-entry">
            <h3>
              {criteria[g].find((x) => x.id === c.id)?.title} ·{' '}
              {criteria[g].find((x) => x.id === c.id)?.weight} ağırlık
            </h3>
            <p>
              <strong>
                {c.score === null ? 'Bilinmiyor' : `${c.score}/5`}
              </strong>{' '}
              · {c.basis}
            </p>
            <p>{c.rationale}</p>
            <p>
              <strong>Değiştirecek bilgi:</strong> {c.change}
            </p>
            <p>Kanıt: {c.evidence.join(', ') || 'Belirlenemedi'}</p>
          </article>
        ))}
      </section>
    ))}
  </details>
  <details>
    <summary>Kanıt defteri, çelişkiler ve ilişkiler</summary>
    <p>
      Özel kaynak dosyaları bu yayında yer almaz. Aşağıdaki güvenli kimlikler
      yerel ayrıntılı inceleme defterine bağlanır; kamuya açık metinler ham
      kaynakların yerine geçmez.
    </p>
    <dl>
      <dt>Kaynak kapsamı</dt>
      <dd>{p.confidence.source}</dd>
      <dt>Teknik davranış</dt>
      <dd>{p.confidence.runtime}</dd>
      <dt>Pazar</dt>
      <dd>{p.confidence.market}</dd>
      <dt>Gelir</dt>
      <dd>{p.confidence.revenue}</dd>
    </dl>
    <h3>Kaynak kayıtları</h3>
    {p.sources.map((e) => (
      <article class="project-entry" id={e.id}>
        <h3>
          {e.id} · {e.title}
        </h3>
        <p>
          {e.kind} · {e.locator} · {e.accessed}
        </p>
        <p>{e.claim}</p>
        <p class="meta">{e.limitation}</p>
        {e.url && (
          <a href={e.url} rel="noreferrer">
            Dış kaynağı aç
          </a>
        )}
      </article>
    ))}
    <h3>Çelişkiler</h3>
    <ul>
      {p.contradictions.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <h3>İlişkiler</h3>
    <ul>
      {p.relationships.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
    <p>
      Analiz sürümü 1.0 · {p.reviewDate} · Kısmi kaynak incelemesine dayanan ilk
      değerlendirme.
    </p>
  </details>
</Layout>
