---
import Layout from '../../layouts/Layout.astro';
import Checklist from '../../components/Checklist.astro';
import { development } from '../../data/development';
import { portfolio } from '../../lib/data';
import {
  kindLabels,
  coverageLabels,
  goalLabels,
  evaluateCandidate,
  strategicCriteria,
  strategicRules,
  assessmentFor,
  assessmentLabels,
  runtimeLabel,
  acceptanceLabel,
} from '../../lib/strategy';
export function getStaticPaths() {
  return development.candidates.map((candidate) => ({
    params: { id: candidate.id },
    props: { candidate },
  }));
}
const { candidate: c } = Astro.props;
const old = portfolio.projects.find((p) => p.id === c.id);
const result = evaluateCandidate(c, 'flow');
const base = import.meta.env.BASE_URL;
---

<Layout title={c.name}>
  <p class="eyebrow">
    {kindLabels[c.kind]} · {coverageLabels[c.coverage]}
  </p>
  <h1>{c.name}</h1>
  <p class="lede">{c.definition}</p>
  <p>Geliştirme odağı: {c.goals.map((g) => goalLabels[g]).join(' · ')}</p>
  <nav class="section-nav" aria-label="Proje bölümleri">
    <a href="#dilim">Geliştirilecek dilim</a>
    <a href="#ilk-adimlar">Adım adım</a>
    <a href="#kabul">Kabul koşulları</a>
    <a href="#olcutler">14 ölçüt</a>
    <a href="#kurallar">ECA kural izi</a>
    <a href="#kanitlar">Kaynaklar</a>
  </nav>
  <section id="dilim" class="reading">
    <h2>Geliştirilecek dilim</h2>
    <h3>{c.slice.title}</h3>
    <p>{c.slice.outcome}</p>
    <dl>
      <dt>Neden şimdi?</dt>
      <dd>{c.rationale}</dd>
      <dt>Karşı görüş</dt>
      <dd>{c.counterargument}</dd>
      <dt>Önceliği değiştirecek kanıt</dt>
      <dd>{c.reconsiderWhen}</dd>
      <dt>Mevcut kaynaktan gözlenen</dt>
      <dd>{c.observed}</dd>
      <dt>Efor</dt>
      <dd>Tahmin edilmedi. {c.effort.reason}</dd>
    </dl>
    <p>
      <strong>İlk ECA önerisi:</strong> {result.label} ·{' '}
      {result.ruleIds.join(', ')}. Bu sonuç geliştirmeyi yasaklamaz; yatırımın
      ilk teknik işini tanımlar.
    </p>
  </section>
  <section id="ilk-adimlar">
    <h2>Adım adım geliştirme</h2>
    <Checklist id={`software-v2-project-${c.id}`} items={c.slice.steps} />
  </section>
  <section id="kabul">
    <h2>Bitmiş sayılması için</h2>
    <ul>
      {c.slice.acceptance.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <p class="meta">
      {runtimeLabel(c)} {acceptanceLabel(c)} Listeyi işaretlemek bu koşulların
      geçtiğini göstermez.
    </p>
  </section>
  <details id="bagimliliklar">
    <summary>Bağımlılıklar ve ortak kullanım</summary>
    {c.dependencies.length ? (
      <ul>
        {c.dependencies.map((d) => (
          <li>
            <strong>{d.title}</strong> ·{' '}
            {d.state === 'observed'
              ? 'Kaynakta gözlenen'
              : d.state === 'inferred'
                ? 'Önerilen ilişki'
                : 'Bilinmiyor'}
            : {d.reason}
            <p>Kanıt: {d.evidenceIds.join(', ') || 'Kaydedilmedi'}</p>
            {d.candidateId && (
              <a href={`${base}projeler/${d.candidateId}/`}>İlgili adayı aç</a>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p>
        Karşılaştırılabilir bağımlılık grafiği kaydedilmedi. Bağımlılık
        bulunmadığı anlamına gelmez.
      </p>
    )}
  </details>
  <details id="olcutler">
    <summary>14 ölçüt: bulgu, kanıt ve karar etkisi</summary>
    {strategicCriteria.map((criterion) => {
      const a = assessmentFor(c, criterion.id);
      return (
        <section class="project-entry">
          <h3>{criterion.title}</h3>
          <p>{criterion.question}</p>
          <p>
            <strong>{assessmentLabels[a.state]}:</strong> {a.finding}
          </p>
          <p>
            <strong>Doğrulama:</strong> {a.verification}
          </p>
          <p>
            <strong>Karara etkisi:</strong> {a.decisionImpact}
          </p>
          <p>Kanıt: {a.evidenceIds.join(', ') || 'Kaydedilmedi'}</p>
        </section>
      );
    })}
  </details>
  <details id="kurallar">
    <summary>ECA kural izi ve tetiklenmeyen koşullar</summary>
    <p>
      Hedef: çalışan ürün akışı. Katalogdaki hedef seçimiyle alternatif görünüm
      incelenebilir. Koşulların bilinmeyen olması açık tutulur. Kesin toplam
      puan kullanılmaz.
    </p>
    {result.conflicts.length > 0 && (
      <p class="notice">
        Çatışan kurallar: {result.conflicts.join(', ')}. Sessiz seçim yapılmadı.
      </p>
    )}
    {result.traces.map((trace) => {
      const rule = strategicRules.find((r) => r.id === trace.id)!;
      return (
        <section class="project-entry">
          <h3>
            {trace.id} · {trace.title}
          </h3>
          <p>
            <strong>Koşul:</strong>{' '}
            {trace.state === 'met'
              ? 'Sağlanıyor'
              : trace.state === 'not_met'
                ? 'Sağlanmıyor'
                : trace.state === 'conflict'
                  ? 'Çelişkili'
                  : 'Bilinmiyor'}{' '}
            · {trace.triggered ? 'Kural tetiklendi' : 'Kural tetiklenmedi'}
          </p>
          <p>{trace.reason}</p>
          <p>
            <strong>Eylem:</strong> {rule.action}
          </p>
          <p>
            Kanıt:{' '}
            {trace.evidenceIds.join(', ') ||
              'Kural politikası veya eksik kanıt; ürün davranışı iddiası değil'}
          </p>
          <a href={`${base}kararlar/#${trace.id.toLowerCase()}`}>
            Gerekçe ve karşı görüşü aç
          </a>
        </section>
      );
    })}
  </details>
  <details id="kanitlar">
    <summary>Kaynaklar ve inceleme sınırı</summary>
    <p>
      Sahiplik: kullanıcının güncel beyanına göre kendi projesi. TÜRSAB
      projeleri bu geliştirme karşılaştırmasının dışında.
    </p>
    <p>
      Güvenli kayıt kimlikleri yerel incelemedeki gözlemlere bağlanır. Kaynakta
      kod veya test bulunması çalışma başarısı değildir. Stratejik çıkarımlar
      ayrıca etiketlenir.
    </p>
    {c.evidence.map((e) => (
      <article class="project-entry" id={`evidence-${e.id}`}>
        <h3>{e.label}</h3>
        <p>
          {e.id} ·{' '}
          {e.kind === 'source'
            ? 'Kaynak gözlemi'
            : e.kind === 'runtime'
              ? 'Çalıştırma kanıtı'
              : e.kind === 'user'
                ? 'Kullanıcı beyanı'
                : 'Analist çıkarımı'}
        </p>
        <p>{e.claim}</p>
        <p class="meta">{e.limitation}</p>
      </article>
    ))}
    {old && (
      <>
        <h3>Önceki ayrıntılı kaynak kaydı</h3>
        <p>
          Önceki gelir odaklı öneriler aktif geliştirme sırası olarak
          kullanılmıyor. Aşağıdaki kayıtlar kaynak tanımı ve sınırları içindir.
        </p>
        {old.sources.map((e) => (
          <article class="project-entry">
            <h4>
              {e.id} · {e.title}
            </h4>
            <p>{e.claim}</p>
            <p class="meta">
              {e.kind} · {e.accessed} · {e.limitation}
            </p>
            {e.url && (
              <a href={e.url} rel="noreferrer">
                Dış kaynağı aç
              </a>
            )}
          </article>
        ))}
      </>
    )}
    <p>
      Strateji sürümü {development.version} · {development.date}. Bütün
      portföyün içerik incelemesi tamamlanmış değildir.
    </p>
  </details>
</Layout>
