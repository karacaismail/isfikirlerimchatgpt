---
import Layout from '../layouts/Layout.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import { development } from '../data/development';
import { developmentPaths } from '../data/strategy-guidance';
const base = import.meta.env.BASE_URL;
---

<Layout title="Geliştirme fırsatları">
  <h1>Hangi çalışma başka işleri de açar?</h1>
  <p class="lede">
    Ortak kabiliyet ve teknik engel, somut ürün akışına bağlandığında yatırım
    gerekçesi olur. Aşağıdaki gruplar öneri niteliğindedir; bir aday birden
    fazla gruba girebilir.
  </p>
  <nav class="section-nav" aria-label="Fırsat odakları">
    {developmentPaths.map((p) => (
      <a href={`#${p.id}`}>{p.title}</a>
    ))}
  </nav>
  {developmentPaths.map((p) => (
    <section class="guide-section" id={p.id}>
      <h2>{p.title}</h2>
      <p>{p.description}</p>
      <a href={`${base}katalog/?goal=${p.id}&focus=${p.id}`}>
        Bu odağı filtreleyerek karşılaştır
      </a>
      <div class="project-grid">
        {development.candidates
          .filter((c) => c.goals.includes(p.id))
          .map((c) => (
            <ProjectSummary candidate={c} />
          ))}
      </div>
    </section>
  ))}
</Layout>
