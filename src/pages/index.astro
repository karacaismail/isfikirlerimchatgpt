---
import Layout from '../layouts/Layout.astro';
import Checklist from '../components/Checklist.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import { portfolio } from '../lib/data';
import { guideClusters } from '../data/guides';
const base = import.meta.env.BASE_URL;
---

<Layout title="Hangi projeye odaklanmalıyım?">
  <header class="page-heading">
    <p class="eyebrow">İş Fikirlerim · Altı kişisel proje</p>
    <h1>Hangi projeye odaklanmalıyım?</h1>
    <p class="lede">
      Önce hedefini seç. Sonra kime, ne satacağını ve bu hafta hangi adımı
      atacağını gör.
    </p>
    <div class="page-actions">
      <a class="button-link" href={`${base}kararlar/`}>
        Başlangıç planını gör
      </a>
      <a class="button-secondary" href={`${base}karsilastir/`}>
        Projeleri karşılaştır
      </a>
    </div>
  </header>

  <section aria-labelledby="hedef-sec">
    <div class="cluster-heading">
      <p class="eyebrow">1. Hedefini seç</p>
      <h2 id="hedef-sec">Şu an neyi öğrenmek istiyorsun?</h2>
    </div>
    <div class="cluster-grid">
      <article class="project-entry">
        <p class="project-tag">İlk ödeme</p>
        <h3>Bir işi satıp teslim etmek</h3>
        <p>Titanlar, AtonotA ve PIM için küçük ücretli işler öneriliyor.</p>
        <a href={`${base}katalog/?cluster=paid`}>
          Ücretli pilot adaylarını gör
        </a>
      </article>
      <article class="project-entry">
        <p class="project-tag">Düzenli kullanım</p>
        <h3>Tekrar ödeme getiren ürün kurmak</h3>
        <p>PIM, HRMS ve İBYS’de önce aynı müşterinin tekrar ihtiyacını sına.</p>
        <a href={`${base}katalog/?revenue=subscription`}>
          Düzenli kullanım adaylarını gör
        </a>
      </article>
      <article class="project-entry">
        <p class="project-tag">Teslim hızı</p>
        <h3>Kendi geliştirme işimi hızlandırmak</h3>
        <p>MetaFramer’ı seçtiğin üründeki tek görevde süre kazancıyla ölç.</p>
        <a href={`${base}katalog/?cluster=internal`}>İç araç planını gör</a>
      </article>
    </div>
  </section>

  <nav class="section-nav" aria-label="Proje grupları">
    {guideClusters.map((cluster) => (
      <a href={`#${cluster.value}`}>{cluster.label}</a>
    ))}
  </nav>

  {guideClusters.map((cluster, index) => (
    <section
      id={cluster.value}
      class="cluster-section"
      aria-labelledby={`${cluster.value}-title`}
    >
      <div class="cluster-heading">
        <p class="eyebrow">{index + 2}. Proje grubu</p>
        <h2 id={`${cluster.value}-title`}>{cluster.label}</h2>
        <p class="lede">{cluster.description}</p>
      </div>
      <div class="cluster-grid">
        {cluster.projectIds.map((id) => {
          const project = portfolio.projects.find((p) => p.id === id)!;
          return <ProjectSummary project={project} />;
        })}
      </div>
      <Checklist
        id={`cluster-${cluster.value}`}
        title="Bu grup için adım adım"
        items={cluster.steps}
      />
      <p>
        <a href={`${base}katalog/?cluster=${cluster.value}`}>
          {cluster.label} grubunu katalogda filtrele
        </a>
      </p>
    </section>
  ))}

  <section class="reading" aria-labelledby="karar-dayanagi">
    <h2 id="karar-dayanagi">Bu öneriler neye dayanıyor?</h2>
    <p>
      Belgeler ve kod incelendi; kaynak ürünler çalıştırılmadı. Gerçek satış ve
      müşteri devamlılığı henüz doğrulanmadı. Buradaki planlar, hangi küçük işi
      önce deneyeceğini seçmene yardımcı olur.
    </p>
    <a href={`${base}yontem/`}>İnceleme kapsamını ve puanlama yöntemini oku</a>
  </section>
</Layout>
