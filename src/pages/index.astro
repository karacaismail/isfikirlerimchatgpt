---
import Layout from '../layouts/Layout.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import { portfolio } from '../lib/data';
const { reviewUpdate: r, projects } = portfolio;
const base = import.meta.env.BASE_URL;
const number = (n: number) => n.toLocaleString('tr-TR');
---

<Layout title="Genel bakış">
  <p class="eyebrow">İş Fikirlerim · {portfolio.date} · İnceleme sürüyor</p>
  <div class="hero">
    <div>
      <h1>Hangi fikir, kimin işini kolaylaştırır?</h1>
      <p class="lede">
        Bir klasör listesi yerine; müşteri, ödeme gerekçesi, mevcut ürün ve
        eksik kanıt üzerinden okunan bir portföy.
      </p>
      <div class="actions">
        <a class="button-link" href={`${base}katalog/`}>
          Projeleri incele
        </a>
        <a href={`${base}kararlar/`}>Önerilen ilk deneyi gör</a>
      </div>
    </div>
    <aside class="notice">
      <h2>Önce kararın dayanağı</h2>
      <p>
        Dosyada anlatılan vizyon, kodda görülen özellik ve güvenli çalıştırmayla
        doğrulanan davranış ayrı tutulur.
      </p>
      <p>
        <strong>Bu incelemede kaynak projeler çalıştırılmadı.</strong> Gelir ve
        müşteri varsayımları doğrulanmış satış değildir.
      </p>
    </aside>
  </div>
  <section aria-label="Portföy sayıları" class="metrics">
    <div class="metric">
      <strong>{projects.length}</strong>Yayımlanan kişisel proje özeti
    </div>
    <div class="metric">
      <strong>{number(r.fullTextFiles)}</strong>Tam metni okunan kaynak dosya
    </div>
    <div class="metric">
      <strong>{number(r.documentTextFiles)}</strong>Metni veya hücreleri
      incelenen belge
    </div>
    <div class="metric">
      <strong>{number(r.formulaCells)}</strong>Yeniden hesaplanıp
      karşılaştırılan formül
    </div>
  </section>
  <section class="notice">
    <h2>Güncel inceleme kaydı</h2>
    <p>
      Sayaçlar {r.capturedAt} tarihli birleşik kayda aittir. Aynı yol ve içerik
      özeti bir kez sayıldı; {number(r.textLines)} metin satırı incelendi.{' '}
      {number(r.partialTextFiles)} metin dosyasının kalan bölümünde üçüncü taraf
      paket kodu ayrıdır. Belge metni, görsel inceleme ve formül kontrolü ayrı
      ölçümlerdir. Bütün portföyün içerik incelemesi henüz tamamlanmadı.
    </p>
    <p>
      İşverene, arkadaşlara veya sahipliği belirsiz içeriklere ait ayrıntılar
      kamuya açık veri kümesine alınmadı. Bazı projelerin yalnız araştırma veya
      gereksinim kanıtı var.
    </p>
  </section>
  <section class="reading">
    <h2>İlk öneri: Titanlar’ın dar ücretli atölyesi</h2>
    <p>
      İki oturum ve beş gerçek ücretli katılımcıyla başlayacak 14 günlük deney,
      yeni bir platform geliştirmeden ödeme ve teslim emeğini ölçebilir. Eğitmen
      yeterliği, ayrılabilir zaman ve izinli erişim kanalı bu önerinin
      koşuludur. Mevcut peşinatlı ve kapsamı doğrulanmış bir AtonotA hizmet işi
      varsa önce o iş gelir. SaaS yönünde PIM’in tek kanal katalog pilotu ayrı
      adaydır.
    </p>
    <a href={`${base}kararlar/`}>
      Sıralamayı ve kararı değiştiren koşulları oku
    </a>
  </section>
  <h2>Kaynaklardan ayrıştırılan kişisel projeler</h2>
  <div class="project-grid">
    {projects.map((project) => (
      <ProjectSummary project={project} />
    ))}
  </div>
  <section>
    <h2>Önceliği değiştirecek kanıt</h2>
    <p class="reading">
      İlk ücretli pilot, uçtan uca iş akışı ve gerçek destek maliyeti çoğu
      kararı değiştirebilir. Kod miktarı tek başına ödeme isteğini göstermez.
    </p>
    <a class="button-link" href={`${base}kararlar/`}>
      Doğrulama deneylerine git
    </a>
  </section>
</Layout>
