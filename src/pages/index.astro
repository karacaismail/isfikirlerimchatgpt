---
import Layout from '../layouts/Layout.astro';
import Checklist from '../components/Checklist.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import { development } from '../data/development';
import { developmentPaths } from '../data/strategy-guidance';
const base = import.meta.env.BASE_URL;
const count = development.candidates.length;
---

<Layout title="Yazılım geliştirme stratejisi">
  <p class="eyebrow">
    Kendi yazılım portföyüm · Strateji {development.version}
  </p>
  <header class="page-heading">
    <h1>Hangi yazılımı geliştirmeye öncelik vermeliyim?</h1>
    <p class="lede">
      Bir ürün akışını tamamla; gereken altyapıyı onunla birlikte geliştir.
      Projeleri alıcı, ekonomik sorun, hazır alternatif, ayrı ödeme gerekçesi ve
      reklamsız erişim üzerinden karşılaştır. Teknik iş ve altyapı katkısını
      ayrıca gör.
    </p>
    <div class="actions">
      <a class="button-link" href={`${base}kararlar/`}>
        Stratejiyi ve ECA kurallarını aç
      </a>
      <a class="quiet-link" href={`${base}katalog/`}>
        {count} adayı filtrele
      </a>
    </div>
  </header>
  <section class="reading">
    <h2>Önce satın alma nedenini karşılaştır</h2>
    <p>
      Önceki PIM / Studio başlangıç sırasını geri çekiyorum. Ürün modeli veya AI
      arayüzü bulunması, müşterinin ayrıca ödeme yapacağı anlamına gelmiyor.
      GenUI bağımsız satış önerisinden çıkarıldı: ERP üreticilerinin AI
      özelliklerine karşı ayrı alıcı ve satın alma nedeni gösterilemedi.
    </p>
    <p>
      Bugünkü karar ticari kazanan ilan etmek değil. Dar alıcı, tekrar eden iş
      ve hazır alternatife karşı geçiş hipotezi kurulabilen seçeneklerde en
      kritik varsayımı sınamak. Altyapı yatırımı, seçilen ürünün gereken
      kabiliyetini tamamladığı ölçüde anlamlı. Hiçbir aday için kalıcı rekabet
      üstünlüğü veya gerçekleşmiş talep doğrulanmış değil.
    </p>
    <p>
      PIM’de tek kanalın ikinci güncellemesi gibi tekrar eden bir işi, hazır CSV
      içe aktarma akışıyla karşılaştırmak değerli bir ilk inceleme olabilir.
      Fark çıkmazsa ayrı PIM ürünü gerekçesi daralır. Bu, peşinat veya satış
      bekleme şartı değildir; geliştirme yatırımının hangi varsayıma dayandığını
      açık tutar.
    </p>
    <div class="actions">
      <a class="button-link" href={`${base}katalog/`}>
        Değer önerisi sınanacakları incele
      </a>
      <a class="quiet-link" href={`${base}katalog/?view=all`}>
        Altyapı ve taslaklar dahil tüm çalışmalar
      </a>
    </div>
  </section>
  <nav class="section-nav" aria-label="Geliştirme yolları">
    {developmentPaths.map((path) => (
      <a href={`#${path.id}`}>{path.title}</a>
    ))}
  </nav>
  {developmentPaths.map((path) => (
    <section id={path.id} class="guide-section">
      <p class="eyebrow">Geliştirme yolu</p>
      <h2>{path.title}</h2>
      <p class="reading">{path.description}</p>
      <Checklist id={`software-v2-cluster-${path.id}`} items={path.steps} />
      <a
        class="button-link"
        href={`${base}katalog/?view=all&goal=${path.id}&focus=${path.id}`}
      >
        Bu odaktaki adayları gör
      </a>
    </section>
  ))}
  <section>
    <h2>Alıcı ve değer gerekçesini aç</h2>
    <p class="reading">
      Ürün, çatı ve platform aynı şey değil. Aşağıdaki kayıtların her birinde
      karşılaştırılan yatırım dilimi açıkça belirtiliyor.
    </p>
    <div class="project-grid">
      {development.candidates
        .filter((c) => c.commercial?.recommended)
        .map((c) => c.id)
        .map((id) => {
          const c = development.candidates.find((c) => c.id === id);
          return c && <ProjectSummary candidate={c} />;
        })}
    </div>
  </section>
</Layout>
