---
import Layout from '../layouts/Layout.astro';
import Checklist from '../components/Checklist.astro';
import { portfolio } from '../lib/data';
import { guideClusters, guideFor } from '../data/guides';
const base = import.meta.env.BASE_URL;
---

<Layout title="Başlangıç planı">
  <header class="page-heading">
    <p class="eyebrow">Bir proje seç · Küçük bir işi dene · Sonucu ölç</p>
    <h1>Bu hafta hangi adımı atmalıyım?</h1>
    <p class="lede">
      Hepsine birden başlama. Müşteriye erişimine ve ayırabildiğin zamana göre
      tek proje seç; aşağıdaki adımlarla ilk sonucu ölç.
    </p>
  </header>
  <nav class="section-nav" aria-label="Başlangıç planı bölümleri">
    <a href="#secim">Önce hangisi?</a>
    {guideClusters.map((cluster) => (
      <a href={`#${cluster.value}`}>{cluster.label}</a>
    ))}
  </nav>
  <section id="secim" class="reading">
    <h2>Önce hangisi?</h2>
    <ol>
      <li>
        <strong>Peşinatı alınmış, kapsamı belli AtonotA işi varsa:</strong> önce
        onu teslim et. Teklif dosyası, ödeme yapılmış olduğu anlamına gelmez.
      </li>
      <li>
        <strong>Hızlı bir gelir deneyi istiyorsan:</strong> Titanlar’da iki
        oturumluk atölyeyi sına. Eğitmen yeterliği, zaman ve ulaşılabilir kitle
        bu önerinin koşulu.
      </li>
      <li>
        <strong>SaaS kurmak istiyorsan:</strong> PIM’de tek kanal ve 100 SKU
        için ücretli katalog işiyle başla. Hazır alıcı varsa bu seçenek öne
        geçebilir.
      </li>
    </ol>
    <p>
      AtonotA içindeki AgencyOps için bir ajansın teslim ve kabul işini elle
      iyileştirmek diğer seçenek. HRMS ve İBYS önce alan ortağı ister.
      MetaFramer’ı seçilen işin iç aracı olarak tut.
    </p>
  </section>

  {guideClusters.map((cluster) => (
    <section
      id={cluster.value}
      class="cluster-section"
      aria-labelledby={`${cluster.value}-plan`}
    >
      <div class="cluster-heading">
        <h2 id={`${cluster.value}-plan`}>{cluster.label}</h2>
        <p class="lede">{cluster.description}</p>
      </div>
      {cluster.projectIds.map((id) => {
        const project = portfolio.projects.find((p) => p.id === id)!;
        const guide = guideFor(id);
        return (
          <article class="project-entry">
            <h3>
              <a href={`${base}projeler/${id}/`}>{project.name}</a>
            </h3>
            <p>{guide.summary}</p>
            <p>
              <strong>İlk teklif:</strong> {guide.firstOffer}
            </p>
            <Checklist
              id={`project-${id}`}
              title={`${project.name} adımları`}
              items={guide.steps}
            />
            <p class="meta">{guide.effort}</p>
            <details>
              <summary>Devam kararını ne değiştirecek?</summary>
              <p>{project.changeEvidence}</p>
              <h4>Önce çözülmesi gerekenler</h4>
              <ul>
                {project.blockers.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </details>
          </article>
        );
      })}
    </section>
  ))}
  <p class="notice reading">
    Bunlar yapılmış deneyler değil, önerilen adımlar. Haftalık zaman ve bütçe
    henüz netleşmedi; ücretli talep ve teslim maliyetine göre önceliği yeniden
    değerlendir.
  </p>
  <div class="page-actions">
    <a class="button-link" href={`${base}katalog/`}>
      Seçenekleri filtrele
    </a>
    <a class="button-secondary" href={`${base}karsilastir/`}>
      İki projeyi karşılaştır
    </a>
  </div>
</Layout>
