---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog';
import { portfolio } from '../lib/data';
---

<Layout title="Karşılaştırma">
  <p class="eyebrow">İki ile dört proje seç</p>
  <h1>Hangisi hedefime daha uygun?</h1>
  <p class="lede">
    Müşteriyi, ilk teklifi, gelir ihtimalini ve kalan işi yan yana gör.
    Bilinmeyen bilgiler ayrıca belirtilir; kesin başarı sırası oluşturulmaz.
  </p>
  <Catalog
    projects={portfolio.projects}
    base={import.meta.env.BASE_URL}
    mode="compare"
    client:load
  />
</Layout>
